{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "cloudflare.config.ts",
    "wrangler.config.ts",
    "deploy/cloudflare-worker.ts",
    ".cloudflare/types/index.d.ts"
  ]
}
