{
  "name": "unitedstats",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "predev": "node -e \"require('node:fs').existsSync('data/united.db')||require('node:child_process').execSync('npm run build:db',{stdio:'inherit'})\"",
    "dev": "next dev",
    "prebuild": "node scripts/prebuild.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "knip": "knip",
    "og:review": "tsx scripts/render-og-review.ts",
    "ingest": "tsx scripts/ingest/engsoccerdata.ts",
    "ingest:wikipedia": "tsx scripts/ingest/wikipedia.ts",
    "ingest:lineups": "tsx scripts/ingest/final-lineups.ts",
    "ingest:football-data": "tsx scripts/ingest/football-data-org.ts",
    "ingest:mufcinfo-lineups": "tsx scripts/ingest/mufcinfo-lineups.ts",
    "ingest:mufcinfo-stadiums": "tsx scripts/ingest/mufcinfo-stadiums.ts",
    "ingest:mufcinfo-assists": "tsx scripts/ingest/mufcinfo-events.ts",
    "ingest:transfermarkt": "tsx scripts/ingest/transfermarkt-datasets.ts",
    "ingest:transfers": "tsx scripts/ingest/mufcinfo-transfers.ts",
    "ingest:pl-transfer-index": "tsx scripts/ingest/pl-transfer-index.ts --write --scrape",
    "ingest:player-records": "tsx scripts/ingest/wikipedia-player-records.ts",
    "ingest:player-media": "tsx scripts/ingest/wikidata-player-media.ts",
    "ingest:manager-media": "tsx scripts/ingest/wikidata-manager-media.ts",
    "ingest:ogscorer-media": "tsx scripts/ingest/wikidata-ogscorer-media.ts",
    "cache:media": "tsx scripts/cache-media.ts",
    "ingest:player-shirts": "tsx scripts/ingest/player-shirt-numbers.ts",
    "ingest:positions": "tsx scripts/ingest/league-positions.ts",
    "ingest:player-positions": "tsx scripts/ingest/wikidata-player-positions.ts",
    "ingest:tableau-goals-assists": "tsx scripts/ingest/tableau-goals-assists.ts",
    "check:static": "node scripts/check-static-render.mjs",
    "check:media": "tsx scripts/check-media.ts",
    "audit:media": "tsx scripts/audit-media.ts",
    "check:perf": "node scripts/check-perf-budgets.mjs",
    "build:db": "tsx scripts/build-db.ts",
    "export:dataset": "tsx scripts/export-dataset.ts",
    "validate": "tsx scripts/validate.ts",
    "copy:extract": "tsx scripts/extract-copy-catalog.ts",
    "copy:persist": "tsx scripts/persist-copy-queue.ts",
    "copy:lint": "tsx scripts/lint-copy.ts",
    "copy:deck": "node scripts/copy-deck.mjs",
    "video:data": "tsx scripts/generate-video-data.ts",
    "video:audio": "node scripts/generate-video-audio.mjs",
    "video:audio:manchester-bakeoff": "node scripts/generate-elevenlabs-manchester-bakeoff.mjs",
    "video:audio:factory-lyrics-bakeoff": "node scripts/generate-elevenlabs-factory-lyrics-bakeoff.mjs",
    "video:sfx": "node scripts/generate-video-sfx.mjs && node scripts/generate-video-opening-sfx.mjs && node scripts/generate-video-body-sfx.mjs",
    "video:validate": "tsx scripts/validate-video-editions.ts",
    "video:prepare": "npm run video:data && npm run video:validate",
    "video:studio": "npm run video:prepare && remotion studio video/index.ts",
    "video:score": "node scripts/generate-video-score.mjs",
    "video:score:force": "node scripts/generate-video-score.mjs --force",
    "video:score:elevenlabs:bakeoff": "node scripts/generate-elevenlabs-bakeoff.mjs",
    "video:score:elevenlabs:bakeoff:force": "node scripts/generate-elevenlabs-bakeoff.mjs --force",
    "video:score:elevenlabs:wide": "node scripts/generate-elevenlabs-wide-bakeoff.mjs",
    "video:score:elevenlabs:wide:force": "node scripts/generate-elevenlabs-wide-bakeoff.mjs --force",
    "video:score:elevenlabs:converge": "node scripts/generate-elevenlabs-convergence-bakeoff.mjs",
    "video:score:elevenlabs:converge:force": "node scripts/generate-elevenlabs-convergence-bakeoff.mjs --force",
    "video:score:elevenlabs:post-punk": "node scripts/generate-elevenlabs-post-punk-finals.mjs",
    "video:score:elevenlabs:post-punk:force": "node scripts/generate-elevenlabs-post-punk-finals.mjs --force",
    "video:render": "npm run video:prepare && remotion render video/index.ts red-thread-european-master-90 output/video/releases/european-master-90/film.mp4",
    "video:render:post-punk:editorial": "npm run video:prepare && remotion render video/index.ts red-thread-european-post-punk-editorial-90 output/video/releases/post-punk-editorial-90/film.mp4",
    "video:render:post-punk:song": "npm run video:prepare && remotion render video/index.ts red-thread-european-post-punk-song-90 output/video/releases/post-punk-song-90/film.mp4",
    "video:render:opening": "npm run video:prepare && remotion render video/index.ts red-thread-european-opening output/video/work/european-master-90/opening.mp4",
    "video:render:timeline": "npm run video:prepare && remotion render video/index.ts red-thread-match-timeline-24 output/video/releases/match-timeline-24/film.mp4",
    "video:render:prototype": "npm run video:audio && remotion render video/index.ts red-thread-loop-prototype output/video/red-thread-loop-prototype.mp4",
    "upload:db": "tsx scripts/upload-db.ts",
    "revalidate": "tsx scripts/revalidate.ts",
    "update": "tsx pipeline/update.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.5.0",
    "better-sqlite3": "^12.10.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.488",
    "@remotion/media": "4.0.488",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "knip": "^6.16.1",
    "playwright": "^1.61.0",
    "remotion": "4.0.488",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "zod": "4.3.6"
  }
}
