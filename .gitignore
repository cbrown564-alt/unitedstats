# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# search telemetry (append-only, runtime — see lib/search/log.ts)
/output/search-log.jsonl

# Local Lighthouse reports and traces; baseline and targets live in docs/PERF.md.
/output/performance/

# typescript
*.tsbuildinfo
next-env.d.ts

# raw open-data downloads (reproducible via scripts/ingest)
/data/raw/

# compiled SQLite db (reproducible via `npm run build:db` from data/canonical)
/data/united.db

# generated client dumps for the static export (reproducible via prebuild)
/public/data/search-index.json
/public/data/matches-catalog.json
/public/data/matches-catalog.v2.json


# Cloudflare generated build and types
/.cloudflare/
/.wrangler/

# generated by scripts/emdash/write-record-index.ts in prebuild
/plugins/record-guard/record-index.json
# Astro + Cloudflare build output (static files go to out/)
/dist/
/.wrangler/

# Astro and EmDash write these on every build
/.astro/
/.emdash/
