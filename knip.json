{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/**/*.{ts,mjs}",
    "pipeline/**/*.ts",
    "remotion.config.ts",
    "video/index.ts",
    "components/mobile/DetailSectionTabs.tsx",
    "cloudflare.config.ts",
    "wrangler.config.ts",
    "deploy/cloudflare-worker.ts",
    "src/pages/**/*.{astro,ts}",
    "src/rt/client.tsx",
    "src/shims/*.{ts,tsx}",
    "src/live.config.ts",
    "src/shims/*.mjs",
    "plugins/*/index.mjs",
    "lib/dbReplay.ts"
  ],
  "ignoreBinaries": [
    "ffmpeg"
  ],
  "ignoreDependencies": [
    "@redthread/record-guard",
    "cloudflare"
  ]
}
