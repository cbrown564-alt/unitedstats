{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "next/link": [
        "./src/shims/next-link.tsx"
      ],
      "next/navigation": [
        "./src/shims/next-navigation.ts"
      ],
      "next/image": [
        "./src/shims/next-image.tsx"
      ],
      "next/dynamic": [
        "./src/shims/next-dynamic.tsx"
      ],
      "next/server": [
        "./src/shims/next-server.ts"
      ],
      "next/og": [
        "./src/shims/next-og.tsx"
      ],
      "next/web-vitals": [
        "./src/shims/next-web-vitals.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".astro/types.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".wrangler"
  ]
}
