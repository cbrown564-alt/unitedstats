---
// Generated by scripts/astro/generate-routes.mjs — edit app/, then re-run.
export const prerender = true;
import * as mod from "@/app/stories/[slug]/page";
import Document from "@/src/rt/Document.astro";
import { pathFor, renderPage, staticPaths } from "@/src/rt/render";

export async function getStaticPaths() {
  return staticPaths(mod);
}
const page = await renderPage(mod, "/stories/[slug]", Astro.params, pathFor("/stories/[slug]", Astro.params));
if (page.kind === "redirect") return Astro.redirect(page.location, page.status);
Astro.response.status = page.status;
---
